// ============================================================
// 통합 Firestore 보안 규칙
// 적용 프로젝트: pour-app-new (단일 프로젝트로 통합)
//   - 박람회·영업앱: admin.html, index.html, defect-diagnosis.html 등
//   - POUR스토어 신규: pourstore-renewal/admin·portal·kiosk·preview
// ============================================================
// 배포 방법: FIREBASE-DEPLOY.md 참조
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 박람회 + 영업앱 컬렉션 (pour-app-new)
    // ─────────────────────────────────────────────
    // 리드 + 백업
    match /leads/{doc}              { allow read, write: if true; }
    match /leads-store/{doc}        { allow read, write: if true; }
    match /leads-grohome/{doc}      { allow read, write: if true; }
    match /leads-method/{doc}       { allow read, write: if true; }
    match /leads-backups/{doc}      { allow read, write: if true; }
    match /history/{doc}            { allow read, write: if true; }

    // 설정
    match /config/{doc}             { allow read, write: if true; }
    match /app-config/{doc}         { allow read, write: if true; }

    // QR + 짧은 링크
    match /qr-stats/{doc}           { allow read, write: if true; }
    match /short-links/{doc}        { allow read, write: if true; }

    // 영업 활동·아웃바운드
    match /activities/{doc}         { allow read, write: if true; }
    match /outbound-solution/{doc}  { allow read, write: if true; }
    match /outbound-method/{doc}    { allow read, write: if true; }
    match /outbound-store/{doc}     { allow read, write: if true; }
    match /outbound-grohome/{doc}   { allow read, write: if true; }

    // 문의·사이트 데이터
    match /partner-inquiries/{doc}  { allow read, write: if true; }
    match /dealer-inquiries/{doc}   { allow read, write: if true; }
    match /site-inquiries/{doc}     { allow read, write: if true; }
    match /site-metrics/{doc}       { allow read, write: if true; }
    match /site-resources/{doc}     { allow read, write: if true; }

    // 하자진단·완공현장
    match /defect-sites/{doc}       { allow read, write: if true; }
    match /defect-diagnosis/{doc}   { allow read, write: if true; }
    match /defect-photos/{doc}      { allow read, write: if true; }
    match /defect-templates/{doc}   { allow read, write: if true; }
    match /step-photos/{doc}        { allow read, write: if true; }
    match /process-guide/{doc}      { allow read, write: if true; }

    // 영업자료·제안서·콘텐츠
    match /sales-docs/{doc}         { allow read, write: if true; }
    match /proposal-slides/{doc}    { allow read, write: if true; }
    match /method-content/{doc}     { allow read, write: if true; }
    match /method-links/{doc}       { allow read, write: if true; }
    match /products/{doc}           { allow read, write: if true; }

    // 고객 리포트·NPS·SMS 로그
    match /customer-reports/{doc}   { allow read, write: if true; }
    match /nps-surveys/{doc}        { allow read, write: if true; }
    match /sms-logs/{doc}           { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // POUR스토어 신규 컬렉션 (pourstore-renewal/*)
    // ─────────────────────────────────────────────
    match /matching-requests/{doc}         { allow read, write: if true; }
    match /partner-companies/{doc}         { allow read, write: if true; }
    match /matching-rules/{doc}            { allow read, write: if true; }
    match /dealers/{doc}                   { allow read, write: if true; }
    match /dealer-orders/{doc}             { allow read, write: if true; }
    match /purchase-orders/{doc}           { allow read, write: if true; }
    match /pourstore-renewal-builder/{doc} { allow read, write: if true; }
    // history 서브컬렉션 — 1MB 한도 회피용 분리 저장 (state/history/{key})
    match /pourstore-renewal-builder/{doc}/{subcoll=**} { allow read, write: if true; }
    match /pourstore-renewal-instances/{doc} { allow read, write: if true; }
    match /pourstore-renewal-products/{doc}  { allow read, write: if true; }
    match /pourstore-renewal-listings/{doc}  { allow read, write: if true; }
    // 자사몰 검색 상단 '관련 컨텐츠' 큐레이션 (pourstore-renewal/admin 포스팅 관리)
    match /pourstore-postings/{doc}          { allow read, write: if true; }
    // 패키지 구성 관리 (부위·등급·베스트·신규) — pourstore-renewal/admin '패키지 구성 관리'
    match /pourstore-packages/{doc}          { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // AI 챗봇센터 (pourstore-renewal/chatbot.html) + 소비자/사내 챗봇
    // ─────────────────────────────────────────────
    match /chatbot-bots/{doc}                { allow read, write: if true; }
    match /chatbot-kb/{doc}                   { allow read, write: if true; }
    match /chatbot-sessions/{doc}             { allow read, write: if true; }
    match /chatbot-leads/{doc}                { allow read, write: if true; }
    match /chatbot-consumer-logs/{doc}        { allow read, write: if true; }
    match /chatbot-internal-logs/{doc}        { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // POUR스토어 업무관리 (work-*) — pourstore-renewal/admin
    // ─────────────────────────────────────────────
    match /work-tasks/{doc}         { allow read, write: if true; }
    match /work-templates/{doc}     { allow read, write: if true; }
    match /work-sales/{doc}         { allow read, write: if true; }
    match /work-categories/{doc}    { allow read, write: if true; }
    match /work-links/{doc}         { allow read, write: if true; }
    match /work-manuals/{doc}       { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // 어드민 담당자 마스터 — pourstore-renewal/admin
    // 향후 OTP 인증(admin-auth) 도입 시 read는 활성 담당자에 한해 허용,
    // write는 isAdmin=true 담당자에 한해 허용하도록 보강 예정 (CLAUDE.md PART 14).
    // ─────────────────────────────────────────────
    match /staff/{doc}              { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // KPI 업무관리센터 (POUR OS → React 흡수) — pour-* 8종
    // 모든 문서는 staffId(어드민 staff 컬렉션의 doc.id)로 소유자 식별.
    // 향후 OTP 인증 도입 시 read 본인+팀 / write 본인만으로 제한 예정.
    // ─────────────────────────────────────────────
    match /pour-tasks/{doc}         { allow read, write: if true; }
    match /pour-recurring/{doc}     { allow read, write: if true; }
    match /pour-projects/{doc}      { allow read, write: if true; }
    match /pour-objectives/{doc}    { allow read, write: if true; }
    match /pour-keyresults/{doc}    { allow read, write: if true; }
    match /pour-kpis/{doc}          { allow read, write: if true; }
    match /pour-meetings/{doc}      { allow read, write: if true; }
    match /pour-journals/{doc}      { allow read, write: if true; }
    match /pour-ai-reviews/{doc}    { allow read, write: if true; }  // 🤖 AI 주간 점검 결과 누적 (데이터 자산화)

    // ─────────────────────────────────────────────
    // POUR스토어 업무관리 — workmgmt.html
    // 단일 문서(main)에 45개 프로젝트 완료 상태 통합 저장.
    // 모든 사용자가 같은 문서를 읽고 쓰므로 실시간 협업 가능.
    // 향후 OTP 인증 도입 시 활동 담당자만 쓰기 허용으로 강화 예정.
    // ─────────────────────────────────────────────
    match /work-mgmt/{doc}          { allow read, write: if true; }
    // 거래코드·채널 관리 (KR 하위 세부 채널 — G 조달청·관급 등 신설/편집)
    match /work-channels/{doc}      { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // KPI Flow 신규 스키마 (pour-firebase.js / pour-migrate.js)
    // staff→users, pour-objectives→goals, pour-keyresults→mainKPIs,
    // pour-kpis(result)→subKPIs, pour-projects→projects, pour-tasks→tasks,
    // pour-meetings→events, 그 외 activityKPIs/personalGoals/retros/aiReviews
    // ─────────────────────────────────────────────
    match /users/{doc}              { allow read, write: if true; }
    match /goals/{doc}              { allow read, write: if true; }
    match /mainKPIs/{doc}           { allow read, write: if true; }
    match /subKPIs/{doc}            { allow read, write: if true; }
    match /projects/{doc}           { allow read, write: if true; }
    match /tasks/{doc}              { allow read, write: if true; }
    match /events/{doc}             { allow read, write: if true; }
    match /events/{doc}/actions/{a} { allow read, write: if true; }  // 회의 액션 서브컬렉션
    match /activityKPIs/{doc}       { allow read, write: if true; }
    match /personalGoals/{doc}      { allow read, write: if true; }
    match /retros/{doc}             { allow read, write: if true; }
    match /aiReviews/{doc}          { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // POUR OS (pourstore-renewal/os) — 컬렉션별 분할 문서 (v2)
    // 앱 상태를 pour-os/state-<collection> 문서들로 분할 저장(+레거시 pour-os/state).
    // {doc=**} 로 state·state-* 형제 문서 및 향후 서브컬렉션까지 모두 허용.
    // ─────────────────────────────────────────────
    // 넷폼 런칭보드(launch-board.html)도 여기 하위 pour-os/launch-board/products/{제품} 에 저장
    // 그로홈 대시보드 데이터도 여기 하위 pour-os/grohome/<원래 컬렉션 이름>/{문서} 에 저장 (2026-10-07 grohome-dashboard 프로젝트에서 이사 ·
    //   무료 요금제 하루 읽기 한도로 막혀 옮김. 규칙 자동 배포가 시크릿 미등록으로 실패 중이라 이미 배포된 이 규칙 범위를 씀)
    match /pour-os/{doc=**}         { allow read, write: if true; }

    // ─────────────────────────────────────────────
    // 소싱-OS (Sourcing/Sourcing-os.html) — 단가·매출 대시보드
    // 앱 상태를 sourcing-os/state 문서에 저장(+레거시 pour-os/sourcing-os-state 마이그레이션).
    // ─────────────────────────────────────────────
    match /sourcing-os/{doc=**}     { allow read, write: if true; }


    // ─────────────────────────────────────────────
    // 🔒 소싱 원가 — 관리자만 (2026-09 · 대표와 협의 후 추가)
    //   sourcing-cost/*        : 제조사 이름·단가·견적·계약·원가·마진 (소싱앱이 공개 문서에서 빼서 여기에 저장)
    //   sourcing-access/roles  : 계정 역할 목록 (로그인한 사람 읽기 · 관리자만 쓰기)
    //   관리자 = 대표 이메일(아래 고정) 또는 roles.admins 목록 · 소싱앱 👥 계정 관리에서 설정
    //   ※ sourcing-os/* 는 외부 셀러 업로드(content-upload)·콘텐츠 OS 가 같이 쓰므로 그대로 둔다
    // ─────────────────────────────────────────────
    function sourcingOwner() {
      return request.auth != null && request.auth.token.email in ['netformrnd@gmail.com'];
    }
    function sourcingAdmin() {
      return request.auth != null && (sourcingOwner() ||
        (exists(/databases/$(database)/documents/sourcing-access/roles) &&
         request.auth.token.email in get(/databases/$(database)/documents/sourcing-access/roles).data.admins));
    }
    match /sourcing-access/{doc}    { allow read: if request.auth != null; allow write: if sourcingAdmin(); }
    match /sourcing-cost/{doc=**}   { allow read, write: if sourcingAdmin(); }

    // ─────────────────────────────────────────────
    // 📊 마케팅 허브 (marketing-hub/) — Aside 자동 업로드 · 판매·광고·재고 (2026-10 · 사용자 작업지시서 3장)
    //   mkt-access/roles   : { admins:[이메일], uploaders:[이메일], staffs:[이메일], people:{} } — 관리자만 읽기·쓰기
    //   mkt-voc/*          : 고객의 소리 — 직원(staffs)은 '새로 만들기'만(개인정보 가린 한 줄), 읽기·고치기는 관리자만
    //   mkt-team/*         : AI 팀 검토 기록 — 관리자만
    //   mkt-uploads/*      : Aside(업로더)가 올린 CSV 원본 — 업로더·관리자는 '새로 만들기'만, 읽기·고치기·지우기는 관리자만
    //   mkt-upload-status/* · mkt-sales · mkt-ads · mkt-stock · mkt-products · mkt-settings : 관리자만
    //   → Aside 계정이 털려도 '이상한 업로드 추가'까지만 가능 (기존 데이터 읽기·고치기·지우기 불가)
    //   관리자 = 대표 이메일(아래 고정) 또는 roles.admins · 화면: marketing-hub/index.html 👥 계정
    // ─────────────────────────────────────────────
    function mktRolesPath() { return /databases/$(database)/documents/mkt-access/roles; }
    function mktAdmin() {
      return request.auth != null && request.auth.token.email is string && (
        request.auth.token.email in ['netformrnd@gmail.com'] ||
        (exists(mktRolesPath()) && request.auth.token.email in get(mktRolesPath()).data.admins));
    }
    function mktUploader() {
      return request.auth != null && request.auth.token.email is string &&
        exists(mktRolesPath()) && request.auth.token.email in get(mktRolesPath()).data.uploaders;
    }
    function mktStaff() {
      return request.auth != null && request.auth.token.email is string &&
        exists(mktRolesPath()) && request.auth.token.email in get(mktRolesPath()).data.get('staffs', []);
    }
    function mktValidVoc(d) {
      return d.keys().hasAll(['product', 'type', 'source', 'text', 'date', 'by', 'createdAt'])
        && d.keys().hasOnly(['product', 'type', 'source', 'text', 'masked', 'urgent', 'date', 'by', 'byEmail', 'createdAt', 'resolved'])
        && d.type in ['불만', '문의', '요청', '칭찬', '하자·안전']
        && d.source in ['전화', '채팅·톡', '게시판·리뷰', '현장·방문', '기타']
        && d.product is string && d.product.size() > 0 && d.product.size() <= 60
        && d.text is string && d.text.size() >= 2 && d.text.size() <= 300
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.by == request.auth.uid
        && d.createdAt == request.time
        && (!('byEmail' in d) || d.byEmail == request.auth.token.email)
        && (!('masked' in d) || (d.masked is int && d.masked >= 0))
        && (!('urgent' in d) || d.urgent is bool)
        && (!('resolved' in d) || d.resolved == false);
    }
    function mktValidUpload(d) {
      return d.keys().hasAll(['channel', 'reportDate', 'csv', 'uploadedBy', 'createdAt'])
        && d.keys().hasOnly(['channel', 'reportDate', 'csv', 'uploadedBy', 'createdAt', 'uploaderEmail', 'rowCount', 'fileName', 'reduced'])
        && d.channel in ['cafe24', 'coupang_ads', 'naver_ads', 'stock']
        && d.reportDate is string && d.reportDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.csv is string && d.csv.size() > 0 && d.csv.size() < 900000
        && d.uploadedBy == request.auth.uid
        && d.createdAt == request.time
        && (!('uploaderEmail' in d) || d.uploaderEmail == request.auth.token.email)
        && (!('rowCount' in d) || (d.rowCount is int && d.rowCount >= 0))
        && (!('fileName' in d) || (d.fileName is string && d.fileName.size() < 300))
        && (!('reduced' in d) || d.reduced is bool);
    }
    match /mkt-access/{doc}         { allow read, write: if mktAdmin(); }
    match /mkt-uploads/{id} {
      allow create: if (mktUploader() || mktAdmin()) && mktValidUpload(request.resource.data);
      allow read, update, delete: if mktAdmin();
    }
    match /mkt-upload-status/{id}   { allow read, write: if mktAdmin(); }
    match /mkt-sales/{id}           { allow read, write: if mktAdmin(); }
    match /mkt-ads/{id}             { allow read, write: if mktAdmin(); }
    match /mkt-stock/{id}           { allow read, write: if mktAdmin(); }
    match /mkt-products/{id}        { allow read, write: if mktAdmin(); }
    match /mkt-settings/{id}        { allow read, write: if mktAdmin(); }
    match /mkt-team/{id}            { allow read, write: if mktAdmin(); }
    match /mkt-voc/{id} {
      allow create: if mktStaff() && mktValidVoc(request.resource.data);
      allow read, write: if mktAdmin();   // 관리자: 끝남 표시 · 임시 저장소에서 옮기기
    }

    // ─────────────────────────────────────────────
    // 기본 정책: 명시되지 않은 컬렉션은 차단
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ⚠️ MVP 단계 보안 정책 안내
// ────────────────────────────────────────────────
// 현재는 인증 없이 read/write 허용 (MVP 운영 단계).
// 운영 안정화 후 단계별 보안 강화 권장 — FIREBASE-DEPLOY.md 참조.
