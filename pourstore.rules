rules_version = '2';
// ─────────────────────────────────────────────────────────────
//  Firestore 보안규칙 — 신규 프로젝트 pourstoreproject 전용
//  (기존 pour-app-new 의 firestore.rules 와 무관 — 절대 혼용 금지)
//
//  방침:
//   · 데이터(원가·공급가·채널·계수)는 "허용목록(config/access.allowedEmails)에 있는 계정"만 읽기 가능
//     → 로그인만 해서는 아무것도 못 봄. 목록에 없는 계정은 전면 차단(서버 강제).
//   · 매입처 암호문(config/secure)은 그중 "마스터 계정 + 이메일 인증"만 읽기 가능
//   · 앱은 config/access 외에는 Firestore 에 쓰지 않음 → 대부분 쓰기 금지
//   · 시딩은 Admin SDK(서비스 계정)로 수행되며 보안규칙을 우회하므로 영향 없음
//   · 공개 회원가입은 사용하지 않음 — 계정은 Firebase 콘솔에서 수동 생성 후 허용목록에 추가
//
//  2026-11-03 (사장님 확정 1A 2A 3A 4A 5B 6A 7A — 팀원별 권한 · 원가·제조사는 넣은 사람만):
//   · config/access.perms {이메일:{barcode,newProd,cost}} = 팀원별 입력 권한 (소유자 마스터만 고침)
//   · 팀원: 바코드 고치기(barcode) · 제품 등록 = 출시준비·원가 없이(newProd) · 자체상품코드는 '새 칸 추가'만
//   · cost-private = 팀원·부마스터가 넣은 원가·제조사 — 마스터 + viewers(넣은 본인·마스터가 지정한 사람)만 읽음
//   · cost-log = 원가 변경 이력(마스터·부마스터) · dashboard-activity = 활동 기록(추가만)
//   · 팀원 화면엔 제조사 가칭도 안 보임 → 팀원의 product-meta/mfg-alias 읽기 뺌
//
//  배포 (자동 배포 없음 — Firebase 콘솔 › Firestore › 규칙 에 이 파일 전체를 붙여 넣고 [게시]):
//   firebase deploy --only firestore:rules --project pourstoreproject
//   (firebase.json 의 firestore.rules 를 이 파일로 지정하거나 --config 로 분리)
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // 인증된 사용자만. 더 조이려면 아래를 이메일 allowlist 로 교체:
    //   function allowed() {
    //     return request.auth != null &&
    //       request.auth.token.email in ['admin@example.com'];
    //   }
    function signedIn() {
      return request.auth != null;
    }
    // 마스터 계정: config/access.masterEmail 과 "이메일 인증된" 로그인 계정이 일치할 때만
    //  → 이 판정은 서버(Firestore)에서 강제되므로, 클라이언트 HTML/JS 를 수정해도 우회 불가.
    function accessExists() {
      return exists(/databases/$(database)/documents/config/access);
    }
    function masterEmail() {
      return get(/databases/$(database)/documents/config/access).data.masterEmail;
    }
    // 추가 마스터 목록(소유자 masterEmail 외). 소유자만 이 배열을 편집할 수 있음(config/access update 규칙).
    function masterEmails() {
      return get(/databases/$(database)/documents/config/access).data.get('masterEmails', []);
    }
    // 마스터: 소유자(masterEmail) 또는 추가 마스터(masterEmails[]) + 이메일 인증
    function isMaster() {
      return signedIn()
        && request.auth.token.email_verified == true
        && accessExists()
        && ( request.auth.token.email == masterEmail()
             || request.auth.token.email in masterEmails() );
    }
    // 데이터 열람 허용: 마스터(소유자·추가)거나 allowedEmails 목록에 있음.
    //  → 어디에도 없는 계정은 로그인해도 채널·제품·계수 read 전면 거부(서버 강제).
    function isAllowedReader() {
      return signedIn()
        && accessExists()
        && ( request.auth.token.email == masterEmail()
             || request.auth.token.email in masterEmails()
             || request.auth.token.email in get(/databases/$(database)/documents/config/access).data.get('allowedEmails', []) );
    }

    // 팀원(팀 대시보드 전용): config/access.teamEmails — 원가가 든 자리는 못 읽고, 아래에 적힌 자리만 (2026-09 대표 동의로 추가)
    function isTeam() {
      return signedIn()
        && accessExists()
        && request.auth.token.email in get(/databases/$(database)/documents/config/access).data.get('teamEmails', []);
    }
    function canTeam() {
      return isAllowedReader() || isTeam();
    }
    // 부마스터: 원가·마진 열람 (공급업체·제조사는 마스터 전용) — 이메일 인증 필요
    function isSubMaster() {
      return signedIn()
        && request.auth.token.email_verified == true
        && accessExists()
        && request.auth.token.email in get(/databases/$(database)/documents/config/access).data.get('subMasterEmails', []);
    }
    // 팀원별 입력 권한 (2026-11-03): config/access.perms[이메일][항목] == true
    function hasPerm(k) {
      return signedIn()
        && accessExists()
        && get(/databases/$(database)/documents/config/access).data.get('perms', {}).get(request.auth.token.email, {}).get(k, false) == true;
    }

    match /channels/{uid} {
      allow read: if isAllowedReader();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if isAllowedReader();
      allow write: if false;
    }

    // 계산/정책 상수 — 허용목록 계정만 읽기, 쓰기 금지
    match /config/calc {
      allow read: if isAllowedReader();
      allow write: if false;
    }

    // 계정 관리 문서 — 마스터 계정 지정.
    //  · 최초 1회만 생성 가능(이미 있으면 불가) + 본인 이메일로만 + 이메일 인증 필수
    //  · 변경(update)은 "현재 마스터 + 이메일 인증"만 가능 → 개발/코드 수정으로는 못 바꿈
    //  · 삭제 금지
    match /config/access {
      allow read: if signedIn();
      // 최초 마스터는 지정 계정(songhee44@netformrnd.com)만 청구 가능 → 선점 경쟁 방지
      allow create: if signedIn()
        && !accessExists()
        && request.auth.token.email_verified == true
        && request.resource.data.masterEmail == request.auth.token.email
        && request.auth.token.email == 'songhee44@netformrnd.com';
      // 클라이언트 update: 현재 마스터 + 이메일 인증만. 단 아래는 클라이언트에서 변경 불가:
      //  · masterEmail 은 절대 불변 → 마스터 변경은 SMS-OTP Worker(Admin)만 수행(코드 수정 우회 불가)
      //  · masterPhone 은 최초 1회(빈 값일 때)만 설정 가능, 이후 변경은 OTP Worker 로만
      //  → allowedEmails / otpWorkerUrl 등 나머지 필드는 마스터가 자유롭게 편집
      allow update: if signedIn()
        && request.auth.token.email_verified == true
        && (
          // (정상) 현재 마스터 본인의 편집 — masterEmail 불변, masterPhone 은 최초 1회만
          ( resource.data.masterEmail == request.auth.token.email
            && request.resource.data.masterEmail == resource.data.masterEmail
            && ( request.resource.data.get('masterPhone', '') == resource.data.get('masterPhone', '')
                 || resource.data.get('masterPhone', '') == '' ) )
          // (복구) masterEmail 이 비어있는 깨진 문서를 지정 계정이 최초 청구 → 부트스트랩 교착 방지
          //  · 오직 지정 계정(songhee44) + 이메일 인증 + 기존 masterEmail 이 빈 값일 때만 허용
          || ( resource.data.get('masterEmail', '') == ''
               && request.auth.token.email == 'songhee44@netformrnd.com'
               && request.resource.data.masterEmail == request.auth.token.email )
        );
      allow delete: if false;
    }

    // 대외비 매입처 암호문 — 마스터(이메일 인증) 계정만 읽기, 쓰기 금지(시딩은 Admin SDK)
    match /config/secure {
      allow read: if isMaster();
      allow write: if false;
    }

    // 보안구역 복호화 키(비밀번호) — 마스터(이메일 인증)만 read/write.
    //  → 마스터는 어느 PC/장소에서든 자동 잠금해제. 일반계정은 규칙상 이 문서를 아예 못 읽음.
    //  → config/secure 자체도 isMaster 전용이므로, 키가 여기 있어도 열람 권한은 마스터로 동일하게 강제됨.
    match /config/seckey {
      allow read, write: if isMaster();
    }

    // ── 마케팅 성과 ──────────────────────────────────────────────
    // 추적 링크: 리다이렉트용으로 read 공개. 생성/삭제·태그편집은 허용목록 계정만.
    //  공개 사용자는 clicks/lastClickAt "1 증가"만 가능(재무값 없음 → 노출돼도 안전).
    //  + 날짜별 클릭(clicksByDay.{YYYY-MM-DD})은 한 번에 하루치 한 칸만 바꿀 수 있음 (2026-09 사용자 동의로 추가)
    match /mkt-links/{id} {
      allow read: if true;
      allow create: if canTeam();
      allow delete: if isAllowedReader();
      allow update: if canTeam()
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks','lastClickAt','clicksByDay'])
             && request.resource.data.clicks == resource.data.clicks + 1
             && request.resource.data.get('clicksByDay', {}).diff(resource.data.get('clicksByDay', {})).affectedKeys().size() <= 1 );
    }
    // 링크별 실측(주문·매출·광고비 등) — 허용목록 계정만(비공개)
    match /mkt-perf/{id} {
      allow read, write: if canTeam();
    }
    // 프로모션 성과 — 허용목록 계정만
    match /promotions/{id} {
      allow read, write: if canTeam();
    }
    // 상품 기준 메타(시장조사최저가·상품별 마케팅·프로모션 파라미터) — 허용목록 계정만
    match /product-meta/{doc} {
      allow read, write: if isAllowedReader();
      // 팀원: 원가 없는 문서만 (행사 구성 순서 · 판매 엑셀 상품 연결 기억 · 자체상품코드 · 바코드)
      //  · 제조사 가칭(mfg-alias)은 2026-11-03 부터 팀원에게 안 보임
      allow read: if isTeam() && doc in ['promo-types', 'sales-map', 'prod-code', 'prod-barcode'];
      allow write: if isTeam() && doc in ['promo-types', 'sales-map'];
      // 바코드 권한 팀원: 바코드 표(map)만 고침
      allow update: if isTeam() && doc == 'prod-barcode' && hasPerm('barcode')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['map', 'updatedAt', 'updatedBy']);
      // 제품 등록 권한 팀원: 새 제품의 자체상품코드 '추가'만 (있는 코드를 바꾸거나 지우지 못함)
      allow update: if isTeam() && doc == 'prod-code' && hasPerm('newProd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['map', 'updatedAt', 'updatedBy'])
        && request.resource.data.map.diff(resource.data.map).changedKeys().size() == 0
        && request.resource.data.map.diff(resource.data.map).removedKeys().size() == 0;
    }
    // 팀용 단가표(원가 없음) — 관리자 화면이 자동으로 만들어 저장, 팀원은 읽기만
    match /team-catalog/{doc} {
      allow read: if canTeam();
      allow write: if isAllowedReader();
    }
    // 공유 상품 원장(앱에서 등록한 상품) — 대시보드·소싱앱 공용. 허용목록 계정 등록·수정·삭제
    match /products-added/{id} {
      allow read, write: if isAllowedReader();
      // 제품 등록 권한 팀원 (2026-11-03): 출시준비 · 원가·제조사·판매가 없이 새로 만들기만 (고치기·지우기는 관리자 화면)
      allow create: if isTeam() && hasPerm('newProd')
        && request.resource.data.createdVia == 'team'
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.status == '출시준비'
        && request.resource.data.type == '단품'
        && request.resource.data.cost == null
        && request.resource.data.mfg == ''
        && request.resource.data.pr.size() == 0
        && request.resource.data.keys().hasOnly(['cat', 'name', 'spec', 'cost', 'pr', 'mfg', 'concept', 'type', 'status', 'setItems',
             'seq', 'updatedAt', 'createdBy', 'createdVia', 'l1', 'l3', 'brands', 'barcode', 'needCost']);
    }
    // 🔑 팀원·부마스터가 넣은 원가·제조사 (2026-11-03 사장님 2A 3A 4A)
    //  · 읽기: 마스터는 전부 · 그 밖엔 viewers 에 든 사람(넣은 본인 · 마스터가 '보여 주기'한 팀원)만
    //  · 팀원(원가 권한)·부마스터: 자기 칸(kind own)만 만들고 고침 — 반영·요청 처리·보여 주기는 마스터
    match /cost-private/{id} {
      allow read: if isMaster()
        || (signedIn() && request.auth.token.email in resource.data.viewers);
      allow create: if isMaster()
        || ( (hasPerm('cost') || isSubMaster())
             && request.resource.data.kind == 'own'
             && request.resource.data.by == request.auth.token.email
             && request.resource.data.viewers == [request.auth.token.email]
             && request.resource.data.status == 'ok'
             && request.resource.data.rev == 1
             && request.resource.data.keys().hasOnly(['kind', 'key', 'name', 'spec', 'cost', 'mfg', 'by', 'viewers', 'status', 'rev',
                  'createdAt', 'updatedAt', 'history']) );
      allow update: if isMaster()
        || ( (hasPerm('cost') || isSubMaster())
             && resource.data.kind == 'own'
             && resource.data.by == request.auth.token.email
             && request.resource.data.status == 'ok'
             && request.resource.data.rev == resource.data.rev + 1
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cost', 'mfg', 'status', 'updatedAt', 'history', 'rev', 'name', 'spec']) );
      allow delete: if isMaster();
    }
    // 원가 변경 이력 — 마스터·부마스터만 (지우기 없음)
    match /cost-log/{id} {
      allow read, create, update: if isMaster() || isSubMaster();
      allow delete: if false;
    }
    // 활동 기록 — 쓴 사람 이름으로 추가만 (고치기·지우기 없음)
    match /dashboard-activity/{id} {
      allow read: if isAllowedReader();
      allow create: if canTeam() && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }
    // 📥 판매 엑셀 업로드 기록 (날짜별 문서 · 묶음 기록 batch-*) — 허용목록 계정 (2026-09 대표와 협의 후 추가)
    match /sales-orders/{id} {
      allow read, write: if canTeam();
    }

    // 그 외 모든 경로(다른 config 문서 포함) 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
